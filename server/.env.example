# Copy this file to .env and fill in your own values.
# Get PLAID_CLIENT_ID and PLAID_SECRET from https://dashboard.plaid.com/team/keys
# (the "Sandbox" secret is free and works with Plaid's fake test banks).

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

PORT=4000

# The origin your frontend is served from, e.g. https://biggfunk.github.io
# Used for CORS. Leave as * only for local testing.
ALLOWED_ORIGIN=*
